function startAutoSlotPull() {
  let currentTries = 0;
  const maxTries = 5;
  let isRunning = false;
  let stopRequested = false;

  // ESC 키를 누르면 언제든지 중단할 수 있는 안전장치
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      stopRequested = true;
      console.log('⛔ ESC 키 입력 → 자동 반복 중단 요청됨');
    }
  });

  function delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  // 지정된 푸터 영역 및 문서 내에서 활성화된 "슬롯 당기기" 버튼을 찾는 함수
  function findSlotButton() {
    // 사용자가 지정한 클래스를 포함하는 다이얼로그 푸터 영역 탐색
    const footerContainer = document.querySelector('div.stds-dialog-footer');
    let targetBtn = null;

    if (footerContainer) {
      targetBtn = [...footerContainer.querySelectorAll('button')].find(btn => {
        const text = btn.innerText.trim();
        const isDisabled = btn.disabled || btn.classList.contains('disabled');
        return text.includes('슬롯 당기기') && !isDisabled;
      });
    }

    // 만약 푸터 영역에서 찾지 못했거나 컨테이너가 없다면 전체 문서에서 탐색
    if (!targetBtn) {
      targetBtn = [...document.querySelectorAll('button')].find(btn => {
        const text = btn.innerText.trim();
        const isDisabled = btn.disabled || btn.classList.contains('disabled');
        return text.includes('슬롯 당기기') && !isDisabled;
      });
    }

    return targetBtn;
  }

  async function step() {
    if (stopRequested || currentTries >= maxTries) {
      console.log(`✅ "슬롯 당기기" 자동 실행 종료 (${currentTries}/${maxTries}회 완료${stopRequested ? ', 사용자에 의해 중단됨' : ''})`);
      isRunning = false;
      return;
    }

    console.log(`🔍 [${currentTries + 1}/${maxTries}] "슬롯 당기기" 버튼 활성화 대기 중...`);

    // 버튼이 활성화될 때까지 대기 (최대 15초 타임아웃)
    let btn = null;
    const startTime = Date.now();
    const timeout = 15000; 

    while (!btn && !stopRequested) {
      btn = findSlotButton();
      if (btn) break;
      
      if (Date.now() - startTime > timeout) {
        console.warn('⚠️ 대기 시간 초과: 활성화된 "슬롯 당기기" 버튼을 찾을 수 없습니다. 자동 중단.');
        isRunning = false;
        return;
      }
      await delay(500); // 0.5초 간격으로 버튼 활성화 여부 확인
    }

    if (stopRequested) {
      console.log('⛔ 중단됨.');
      isRunning = false;
      return;
    }

    // 버튼 클릭 실행
    btn.click();
    currentTries++;
    console.log(`✨ [${currentTries}/${maxTries}] "슬롯 당기기" 버튼 클릭 완료!`);

    // 슬롯 애니메이션 및 결과 처리가 진행될 수 있도록 충분히 대기 (예: 2초)
    await delay(2000);

    // 다음 회차 진행
    setTimeout(step, 500);
  }

  // ▶️ 실행 시작 제어
  if (isRunning) return;
  isRunning = true;
  console.log('🚀 "슬롯 당기기" 자동 반복 스크립트 시작 (총 5회)');
  step();
}

// 스크립트 붙여넣기 시 즉시 실행
startAutoSlotPull();
