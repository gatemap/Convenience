function startAutoSlotPull() {
  let currentTries = 0;
  const maxTries = 5;
  let isRunning = false;
  let stopRequested = false;

  // ESC 키를 누르면 언제든지 중단할 수 있는 안전장치
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      stopRequested = true;
      console.log('⛔ ESC 키 입력 → 자동 반복 중단 요청됨');
    }
  });

  function delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  // 버튼이 실제로 비활성화 상태인지 다각도로 엄격하게 판별하는 함수
  function isButtonDisabled(btn) {
    if (!btn) return true;

    // 1. 표준 disabled 속성/프로퍼티 확인
    if (btn.disabled || btn.getAttribute('disabled') !== null) return true;

    // 2. 접근성(ARIA) 비활성화 속성 확인
    if (btn.getAttribute('aria-disabled') === 'true') return true;

    // 3. 흔히 쓰이는 비활성화 관련 클래스명 검사
    const classListStr = btn.className.toLowerCase();
    const disabledClasses = ['disabled', 'is-disabled', 'disable', 'off', 'inactive', 'lock', 'locked', 'dimmed', 'readonly'];
    if (disabledClasses.some(cls => classListStr.includes(cls))) return true;

    // 4. CSS 스타일을 통한 클릭 차단 상태 검사
    const style = window.getComputedStyle(btn);
    if (style.pointerEvents === 'none' || style.display === 'none' || style.visibility === 'hidden') return true;

    // 5. 시각적으로 비활성화된 것처럼 투명도가 지나치게 낮은 경우
    if (parseFloat(style.opacity) < 0.6) return true;

    return false;
  }

  // 지정된 푸터 영역 및 문서 내에서 활성화된 "슬롯 당기기" 버튼을 찾는 함수
  function findSlotButton() {
    const footerContainer = document.querySelector('div.stds-dialog-footer');
    let targetBtn = null;
    const selector = 'button, [role="button"]';

    if (footerContainer) {
      targetBtn = [...footerContainer.querySelectorAll(selector)].find(btn => {
        const text = btn.innerText.trim();
        return text.includes('슬롯 당기기') && !isButtonDisabled(btn);
      });
    }

    if (!targetBtn) {
      targetBtn = [...document.querySelectorAll(selector)].find(btn => {
        const text = btn.innerText.trim();
        return text.includes('슬롯 당기기') && !isButtonDisabled(btn);
      });
    }

    return targetBtn;
  }

  async function step() {
    if (stopRequested || currentTries >= maxTries) {
      console.log(`✅ "슬롯 당기기" 자동 실행 종료 (${currentTries}/${maxTries}회 완료${stopRequested ? ', 사용자에 의해 중단됨' : ''})`);
      isRunning = false;
      return;
    }

    console.log(`🔍 [${currentTries + 1}/${maxTries}] "슬롯 당기기" 버튼 활성화 대기 중...`);

    // 1단계: 버튼이 활성화될 때까지 대기 (최대 30초 타임아웃)
    let btn = null;
    const startTime = Date.now();
    const timeout = 30000; 

    while (!btn && !stopRequested) {
      btn = findSlotButton();
      if (btn) break;
      
      if (Date.now() - startTime > timeout) {
        console.warn('⚠️ 대기 시간 초과: 활성화된 "슬롯 당기기" 버튼을 찾을 수 없습니다. 자동 중단.');
        isRunning = false;
        return;
      }
      await delay(500);
    }

    if (stopRequested) {
      console.log('⛔ 중단됨.');
      isRunning = false;
      return;
    }

    // 2단계: 버튼 클릭 실행
    btn.click();
    currentTries++;
    console.log(`✨ [${currentTries}/${maxTries}] "슬롯 당기기" 버튼 클릭 완료! 보상 확정 및 재활성화 대기 중...`);

    // 클릭 직후 UI가 반응할 수 있도록 1초 대기
    await delay(1000);

    // 3단계: 보상이 확정되어 "슬롯 당기기" 버튼이 다시 활성화될 때까지 대기 (최대 60초 타임아웃)
    const rewardWaitStart = Date.now();
    const rewardTimeout = 60000;
    let nextBtn = null;

    while (!stopRequested) {
      nextBtn = findSlotButton();
      if (nextBtn) {
        // 버튼이 다시 활성화됨 = 보상 확정 완료 상태
        console.log(`🔓 보상 확정 확인됨. 다음 회차 준비 완료.`);
        break;
      }

      if (Date.now() - rewardWaitStart > rewardTimeout) {
        console.warn('⚠️ 보상 확정 대기 시간 초과: 버튼이 다시 활성화되지 않았습니다. 자동 중단.');
        isRunning = false;
        return;
      }

      await delay(500); // 0.5초 간격으로 버튼 활성화 여부 확인
    }

    if (stopRequested) {
      console.log('⛔ 중단됨.');
      isRunning = false;
      return;
    }

    // 다음 회차 진행
    setTimeout(step, 500);
  }

  // ▶️ 실행 시작 제어
  if (isRunning) return;
  isRunning = true;
  console.log('🚀 "슬롯 당기기" 자동 반복 스크립트 시작 (총 5회)');
  step();
}

// 스크립트 붙여넣기 시 즉시 실행
startAutoSlotPull();
